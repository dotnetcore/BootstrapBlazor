<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <StaticWebAssetSpaFallbackEnabled>true</StaticWebAssetSpaFallbackEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="11.0.0-rc.2.26504.105" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Gateway" Version="11.0.0-rc.2.26504.105" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BootstrapBlazor\BootstrapBlazor.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\BootstrapBlazor.Server\Extensions\MenusLocalizerExtensions.cs" Link="Extensions\MenusLocalizerExtensions.cs" />
    <EmbeddedResource Include="..\BootstrapBlazor.Server\Locales\en-US.json" Link="Locales\en-US.json">
      <LogicalName>BootstrapBlazor.Client.Locales.en-US.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\BootstrapBlazor.Server\Locales\zh-CN.json" Link="Locales\zh-CN.json">
      <LogicalName>BootstrapBlazor.Client.Locales.zh-CN.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Using Include="BootstrapBlazor.Components" />
    <Using Include="BootstrapBlazor.Client.Services" />
    <Using Include="BootstrapBlazor.Server.Components.Components" />
    <Using Include="BootstrapBlazor.Server.Components.Layout" />
    <Using Include="BootstrapBlazor.Server.Extensions" />
    <Using Include="Microsoft.Extensions.Localization" />
    <Using Include="Microsoft.AspNetCore.Components" />
  </ItemGroup>

</Project>
