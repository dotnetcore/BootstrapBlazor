@inject IStringLocalizer<BootstrapBlazor.Server.Components.Samples.DateTimePickers> Localizer

<div class="row g-3">
    <div class="col-12">
        <DateTimePicker @bind-Value="DateValue" DisplayText="@Localizer["NestedDateLabel"]" ShowLabel="true" />
    </div>
    <div class="col-12">
        <DateTimePicker @bind-Value="SidebarDateValue" DisplayText="@Localizer["NestedSidebarDateLabel"]" ShowLabel="true" ShowSidebar="true">
            <SidebarTemplate Context="selectDate">
                <div class="sidebar-item" @onclick="() => selectDate(DateTime.Today.AddDays(1 - DateTime.Today.Day))">
                    <i class="fa-fw fa-solid fa-home"></i>
                    <span>@Localizer["SidebarMonthStart"]</span>
                </div>
                <div class="sidebar-item" @onclick="() => selectDate(DateTime.Today.AddDays(1 - DateTime.Today.Day))">
                    <i class="fa-fw fa-solid fa-home"></i>
                    <span>@Localizer["SidebarMonthStart"]</span>
                </div>
                <div class="sidebar-item" @onclick="() => selectDate(DateTime.Today.AddDays(1 - DateTime.Today.Day))">
                    <i class="fa-fw fa-solid fa-home"></i>
                    <span>@Localizer["SidebarMonthStart"]</span>
                </div>
                <div class="sidebar-item" @onclick="() => selectDate(DateTime.Today.AddDays(1 - DateTime.Today.Day))">
                    <i class="fa-fw fa-solid fa-home"></i>
                    <span>@Localizer["SidebarMonthStart"]</span>
                </div>
                <div class="sidebar-item" @onclick="() => selectDate(DateTime.Today.AddDays(1 - DateTime.Today.Day))">
                    <i class="fa-fw fa-solid fa-home"></i>
                    <span>@Localizer["SidebarMonthStart"]</span>
                </div>
                <div class="sidebar-item" @onclick="() => selectDate(DateTime.Today.AddDays(1 - DateTime.Today.Day))">
                    <i class="fa-fw fa-solid fa-home"></i>
                    <span>@Localizer["SidebarMonthStart"]</span>
                </div>
            </SidebarTemplate>
        </DateTimePicker>
    </div>
    <div class="col-12">
        <DateTimePicker @bind-Value="DateTimeValue" ViewMode="DatePickerViewMode.DateTime" ShowLabel="true"
                        PickTimeMode="PickTimeMode.Clock" DisplayText="@Localizer["NestedDateTimeLabel"]" />
    </div>
    <div class="col-12">
        <DateTimeRange @bind-Value="RangeValue" ShowSidebar="false" ShowLabel="true" DisplayText="@Localizer["NestedRangeLabel"]" />
    </div>
    <div class="col-12">
        <DateTimeRange @bind-Value="SidebarRangeValue" ShowSidebar="true" ShowLabel="true" DisplayText="@Localizer["NestedSidebarRangeLabel"]">
            <SidebarTemplate Context="selectRange">
                <div class="sidebar-item" @onclick="() => selectRange(new DateTimeRangeValue
                {
                    Start = DateTime.Today.AddDays(1 - DateTime.Today.Day),
                    End = DateTime.Today.AddDays(1 - DateTime.Today.Day).AddMonths(1).AddMilliseconds(-1)
                })">
                    <i class="fa-fw fa-solid fa-calendar-days"></i>
                    <span>@Localizer["SidebarThisMonth"]</span>
                </div>
            </SidebarTemplate>
        </DateTimeRange>
    </div>
</div>

@code {
    /// <summary>
    /// <para lang="zh">获得/设置 表单日期。</para>
    /// <para lang="en">Gets or sets the form date.</para>
    /// </summary>
    [Required]
    public DateTime? DateValue { get; set; }

    /// <summary>
    /// <para lang="zh">获得/设置 自定义侧边栏日期。</para>
    /// <para lang="en">Gets or sets the custom sidebar date.</para>
    /// </summary>
    public DateTime? SidebarDateValue { get; set; }

    /// <summary>
    /// <para lang="zh">获得/设置 表单日期时间。</para>
    /// <para lang="en">Gets or sets the form date and time.</para>
    /// </summary>
    public DateTime? DateTimeValue { get; set; } = DateTime.Now;

    /// <summary>
    /// <para lang="zh">获得/设置 表单日期范围。</para>
    /// <para lang="en">Gets or sets the form date range.</para>
    /// </summary>
    public DateTimeRangeValue RangeValue { get; set; } = new();

    /// <summary>
    /// <para lang="zh">获得/设置 自定义侧边栏日期范围。</para>
    /// <para lang="en">Gets or sets the custom sidebar date range.</para>
    /// </summary>
    public DateTimeRangeValue SidebarRangeValue { get; set; } = new();
}
