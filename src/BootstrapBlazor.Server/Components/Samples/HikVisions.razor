@page "/hik-vision"
@inject IStringLocalizer<HikVisions> Localizer

<h3>@Localizer["Title"]</h3>

<h4>@Localizer["SubTitle"]</h4>

<Tips>
    <p>@((MarkupString)Localizer["PackageIntro"].Value)</p>
</Tips>

<PackageTips Name="BootstrapBlazor.HikVision" />

<DemoBlock Title="@Localizer["WebRtcTitle"]" Introduction="@Localizer["WebRtcIntro"]" Name="WebRtc">
    <section ignore>
    </section>
    <Button OnClick="ToggleWebRtc" class="mb-3">@Localizer[_showWebRtc ? "WebRtcDisconnect" : "WebRtcConnect"]</Button>
    @if (_showWebRtc)
    {
        <HikVisionWebRtc GatewayUrl="http://127.0.0.1:8889/hikvision/" Title="@Localizer["WebRtcTitle"]"
                         class="mb-3" style="max-width: 960px;" />
    }
</DemoBlock>

<DemoBlock Title="@Localizer["BasicUsageTitle"]" Introduction="@Localizer["BasicUsageIntro"]" Name="Normal">
    <section ignore>
        <p class="code-label">@Localizer["NotesTitle"]</p>
        <ul class="ul-demo">
            <li>@((MarkupString)Localizer["PluginNote"].Value)</li>
            <li>@Localizer["ConsoleNote"]</li>
            <li>@Localizer["PreviewWindowNote"]</li>
        </ul>
        <p class="code-label">@Localizer["CaptureNotesTitle"]</p>
        <ul class="ul-demo">
            <li>@Localizer["CaptureRequiresPreview"]</li>
            <li>@((MarkupString)Localizer["CaptureStorageNote"].Value)</li>
            <li>@((MarkupString)Localizer["CaptureMethodsNote"].Value)</li>
        </ul>
        <p class="code-label">@Localizer["RecordingNotesTitle"]</p>
        <ul class="ul-demo">
            <li>@Localizer["RecordingRequiresPreview"]</li>
            <li>@((MarkupString)Localizer["RecordingStorageNote"].Value)</li>
        </ul>
    </section>
    <HikVisionWebPlugin @ref="_hikVision" OnInitedAsync="OnInitedAsync"
                        OnLoginAsync="OnLoginAsync" OnLogoutAsync="OnLogoutAsync" OnGetChannelsAsync="OnGetChannelsAsync"
                        OnStartRealPlayedAsync="OnStartRealPlayedAsync" OnStopRealPlayedAsync="OnStopRealPlayedAsync"></HikVisionWebPlugin>
    <section ignore>
        <div class="row form-inline g-3" style="--bb-input-group-label-width: 88px;">
            <div class="col-12 col-sm-6">
                <BootstrapInputGroup>
                    <BootstrapInputGroupLabel DisplayText="@Localizer["IpAddress"]"></BootstrapInputGroupLabel>
                    <BootstrapInput @bind-Value="@_ip"></BootstrapInput>
                </BootstrapInputGroup>
            </div>
            <div class="col-12 col-sm-6">
                <BootstrapInputGroup>
                    <BootstrapInputGroupLabel DisplayText="@Localizer["Port"]"></BootstrapInputGroupLabel>
                    <BootstrapInput @bind-Value="@_port"></BootstrapInput>
                </BootstrapInputGroup>
            </div>
            <div class="col-12 col-sm-6">
                <BootstrapInputGroup>
                    <BootstrapInputGroupLabel DisplayText="@Localizer["UserName"]"></BootstrapInputGroupLabel>
                    <BootstrapInput @bind-Value="@_userName"></BootstrapInput>
                </BootstrapInputGroup>
            </div>
            <div class="col-12 col-sm-6">
                <BootstrapInputGroup>
                    <BootstrapInputGroupLabel DisplayText="@Localizer["Password"]"></BootstrapInputGroupLabel>
                    <BootstrapPassword @bind-Value="@_password"></BootstrapPassword>
                </BootstrapInputGroup>
            </div>
            @if (_inited)
            {
                <div class="col-12 col-sm-6">
                    <BootstrapInputGroup>
                        <BootstrapInputGroupLabel DisplayText="@Localizer["StreamType"]"></BootstrapInputGroupLabel>
                        <Select @bind-Value="_streamType" Items="_streamTypes"></Select>
                    </BootstrapInputGroup>
                </div>
                <div class="col-12 col-sm-6">
                    <BootstrapInputGroup>
                        <BootstrapInputGroupLabel DisplayText="@Localizer["VideoChannel"]"></BootstrapInputGroupLabel>
                        <Select @bind-Value="_channelId" Items="_analogChannels"></Select>
                    </BootstrapInputGroup>
                </div>
                <div class="col-12">
                    <div class="hik-controls">
                        <Button OnClick="OnLoginClickAsync" IsDisabled="@IsDisabledLoginButton"
                                IsKeepDisabled="@IsDisabledLoginButton" IsAsync="true">
                            <span>@Localizer["Login"]</span>
                        </Button>
                        <Button OnClick="OnLogoutClickAsync" IsDisabled="_logoutStatus" IsKeepDisabled="_logoutStatus" IsAsync="true">
                            <span>@Localizer["Logout"]</span>
                        </Button>
                        <Button OnClick="OnStartRealPlayAsync" IsDisabled="_startRealPlayStatus">
                            <span>@Localizer["StartRealPlay"]</span>
                        </Button>
                        <Button OnClick="OnStopRealPlayAsync" IsDisabled="_stopRealPlayStatus">
                            <span>@Localizer["StopRealPlay"]</span>
                        </Button>
                        <Button OnClick="OnOpenSoundAsync" IsDisabled="_openSoundStatus">
                            <span>@Localizer["OpenSound"]</span>
                        </Button>
                        <Button OnClick="OnCloseSoundAsync" IsDisabled="_closeSoundStatus">
                            <span>@Localizer["CloseSound"]</span>
                        </Button>
                        <Button OnClick="OnCaptureAsync" IsDisabled="_stopRealPlayStatus">
                            <span>@Localizer["CapturePicture"]</span>
                        </Button>
                        <Button OnClick="OnCaptureAndDownloadAsync" IsDisabled="_stopRealPlayStatus">
                            <span>@Localizer["CapturePictureAndDownload"]</span>
                        </Button>
                        <Button OnClick="OnStartRecordAsync" IsDisabled="_startRecordStatus">
                            <span>@Localizer["StartRecord"]</span>
                        </Button>
                        <Button OnClick="OnStopRecordAsync" IsDisabled="_stopRecordStatus">
                            <span>@Localizer["StopRecord"]</span>
                        </Button>
                        <Dropdown Value="@_iWndType" IsDisabled="false" Items="_iWndTypes"
                                  MenuAlignment="Alignment.Right" OnSelectedItemChanged="OnWndTypeChangedAsync">
                            <ButtonTemplate>
                                <span>@Localizer["WindowLayout", context.Text]</span>
                            </ButtonTemplate>
                        </Dropdown>
                    </div>
                </div>
            }
        </div>
    </section>
</DemoBlock>

@code {
    private RenderFragment RenderPluginDownloadFooter =>
    @<div>@Localizer["PluginDownloadBefore"].Value<a href="https://open.hikvision.com/download/5cda567cf47ae80dd41a54b3?type=20&id=77c7f9ab64da4dbe8b2df7efe3365ec2" target="_blank" style="margin:0 8px;">@Localizer["PluginDownloadLink"].Value</a>@Localizer["PluginDownloadAfter"].Value</div>;
}
