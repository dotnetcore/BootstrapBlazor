<Router AppAssembly="@typeof(Program).Assembly"
        AdditionalAssemblies="new[] { typeof(SamplePage).Assembly }"
        NotFoundPage="typeof(Pages.NotFound)">
    <Found Context="routeData">
        <LayoutView Layout="@GetShellLayout(routeData.PageType)">
            @if (routeData.PageType.Assembly == typeof(SamplePage).Assembly)
            {
                <SamplePage PageTypeName="@(routeData.PageType.FullName!)"
                            RouteValues="@routeData.RouteValues.ToDictionary(p => p.Key, p => (string?)p.Value)"
                            @rendermode="new InteractiveAutoRenderMode()" />
            }
            else
            {
                <ServerPage PageTypeName="@(routeData.PageType.FullName!)"
                            RouteValues="@routeData.RouteValues.ToDictionary(p => p.Key, p => (string?)p.Value)"
                            @rendermode="new InteractiveServerRenderMode()" />
            }
        </LayoutView>
    </Found>
</Router>

@code {
    private static Type? GetShellLayout(Type pageType)
    {
        var layout = pageType.GetCustomAttribute<LayoutAttribute>()?.LayoutType ?? typeof(MainLayout);
        while (layout != null)
        {
            if (layout == typeof(MainLayout) || layout == typeof(BaseLayout))
            {
                return layout;
            }
            layout = layout.GetCustomAttribute<LayoutAttribute>()?.LayoutType;
        }
        return null;
    }
}
