<Router AppAssembly="@typeof(Program).Assembly"
        AdditionalAssemblies="new[] { typeof(RoutePage).Assembly }"
        NotFoundPage="typeof(Pages.NotFound)">
    <Found Context="routeData">
        @{
            var pageType = routeData.PageType;
            var pageTypeName = pageType.FullName!;
            var pageAssemblyName = pageType.Assembly.GetName().Name!;
            var routeValues = routeData.RouteValues.ToDictionary(p => p.Key, p => (string?)p.Value);
            IComponentRenderMode renderMode = pageType.Assembly == typeof(RoutePage).Assembly
                ? new InteractiveAutoRenderMode()
                : new InteractiveServerRenderMode();
        }
        @* Only shared pages are available to the WebAssembly client. *@
        <RoutePage PageTypeName="@pageTypeName"
                   PageAssemblyName="@pageAssemblyName"
                   RouteValues="@routeValues"
                   @rendermode="renderMode" />
    </Found>
</Router>
