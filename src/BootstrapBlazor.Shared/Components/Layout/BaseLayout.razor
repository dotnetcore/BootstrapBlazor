@inherits LayoutComponentBase

@if (ServerPageContent)
{
    @Body
}
else
{
    <HeaderOutlet @rendermode="new InteractiveAutoRenderMode()" />
    <main>
        @Body
    </main>

    <div id="blazor-error-ui">
        An unhandled error has occurred.
        <a href="" class="reload">Reload</a>
        <a class="dismiss">🗙</a>
    </div>
}
