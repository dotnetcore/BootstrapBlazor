<div class="table-attr">
    <p class="table-attr-desc">
        <span class="code-label">@Title</span>
        @if (Type != null || Items != null)
        {
            <span class="table-attr-mark">Automatically generated</span>
        }
    </p>

    <Table TItem="AttributeItem" Items="_items" IsBordered="true" IsStriped="true" ShowFooter="@ShowFooter">
        <TableColumns>
            <TableColumn @bind-Field="@context.Name">
                <Template Context="v">
                    <span id="@GetPropertyAnchor(v.Row.Name)">
                        @if (v.Row.IsObsolete)
                        {
                            <span class="text-decoration-line-through text-danger me-2">@v.Value</span>
                            <Badge Color="Color.Danger" IsPill="true">
                                @Localizer["Obsolete"]
                            </Badge>
                        }
                        else
                        {
                            @v.Value
                        }
                    </span>
                </Template>
            </TableColumn>
            <TableColumn @bind-Field="@context.Description" TextWrap="true">
                <Template Context="v">
                    @if (v.Row.DescriptionParts is { Count: > 0 })
                    {
                        <div>
                            @foreach (var part in v.Row.DescriptionParts)
                            {
                                @if (part.Target is { } target && _items.Any(item => item.Name == target))
                                {
                                    <a class="table-attr-link" href="@GetPropertyAnchorUrl(target)">@part.Text</a>
                                }
                                else
                                {
                                    @part.Text
                                }
                            }
                        </div>
                    }
                    else
                    {
                        @v.Value
                    }
                </Template>
            </TableColumn>
            <TableColumn @bind-Field="@context.Type" TextWrap="true" Width="180"></TableColumn>
            <TableColumn @bind-Field="@context.Version" />
        </TableColumns>
        <TableFooter>
            <TableFooterCell Text="@Localizer["Total"]" colspan="3" Align="Alignment.Left" />
            <TableFooterCell Aggregate="AggregateType.Count" Field="@nameof(AttributeItem.Name)" />
        </TableFooter>
    </Table>
</div>
