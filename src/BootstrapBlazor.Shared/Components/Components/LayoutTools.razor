@inject IOptions<WebsiteOptions> WebsiteOption
@inject IStringLocalizer<MainLayout> Localizer

<DialButton DialMode="DialMode.Radial" Icon="fa-solid fa-gear" Radius="100" Placement="Placement.BottomEnd" class="bb-dial-gear">
    <ButtonTemplate>
        <div class="btn-circle btn-fade dial-button-gear">
            <img src="@WebsiteOption.Value.GetAssetUrl("images/logo.png")" alt="logo" />
        </div>
    </ButtonTemplate>
    <ChildContent>
        <DialButtonItem>
            <ThemeMode></ThemeMode>
        </DialButtonItem>
        <DialButtonItem>
            <Tooltip Title="@Localizer["ChatTooltip"]" Placement="Placement.Left" class="btn btn-circle btn-fade btn-dial-item d-flex">
                <a href="./ai-chat">
                    <i class="fa-solid fa-comments"></i>
                </a>
            </Tooltip>
        </DialButtonItem>
        <DialButtonItem>
            <ThemeChooser></ThemeChooser>
        </DialButtonItem>
        <DialButtonItem>
            <Tooltip Title="@Localizer["UpdateTooltip"]" Placement="Placement.Left" class="btn btn-circle btn-fade btn-dial-item d-flex">
                <a href="@WebsiteOption.Value.WikiUrl" target="_blank">
                    <i class="fa-solid fa-file-circle-check"></i>
                </a>
            </Tooltip>
        </DialButtonItem>
    </ChildContent>
</DialButton>
<BootstrapBlazorRootOutlet RootName="bb-layout-tools" />
