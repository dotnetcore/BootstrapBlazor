@page "/dispatch"
@inject IStringLocalizer<Dispatches> Localizer
@inject IDispatchService<MessageItem> DispatchService

<h3>@Localizer["Title"]</h3>
<h4>@Localizer["Description"]</h4>

<Tips class="mt-3">
    <p>@((MarkupString)Localizer["Tips"].Value)</p>
</Tips>

<p>@((MarkupString)Localizer["AsyncTip"].Value)</p>
<p>@((MarkupString)Localizer["DeliveryTip"].Value)</p>

<p>@Localizer["SignalRRegistration"]</p>
<Pre>// Client
builder.Services.AddBootstrapBlazorHub();

// Server
builder.Services.AddBootstrapBlazorHub(options =>
{
    options.Allow&lt;MessageItem&gt;(allowClientPublish: true);
});
app.MapBootstrapBlazorHub();</Pre>
<p>@Localizer["SignalRDelivery"]</p>

<p>@Localizer["NormalTip"]</p>
<p>@((MarkupString)Localizer["NormalTips1"].Value)</p>
<Pre class="mb-3">[Inject]
[NotNull]
private IDispatchService&lt;MessageItem&gt;? DispatchService { get; set; }</Pre>
<p>@((MarkupString)Localizer["NormalTips2"].Value)</p>
<Pre class="mb-3">protected override async Task OnInitializedAsync()
{
    await base.OnInitializedAsync();
    await DispatchService.SubscribeAsync(Notify);
}</Pre>
<p>@((MarkupString)Localizer["NormalTips3"].Value)</p>
<Pre class="mb-3">// Component implements IAsyncDisposable
public async ValueTask DisposeAsync()
{
    await DispatchService.UnSubscribeAsync(Notify);
}</Pre>
<p>@((MarkupString)Localizer["NormalTips4"].Value)</p>
<Pre class="mb-3">private Task Notify(DispatchEntry&lt;MessageItem&gt; payload) => InvokeAsync(async () =>
{
    if (payload.Entry != null)
    {
        var option = new ToastOption()
        {
            Category = ToastCategory.Information,
            Title = @Localizer["NormalTipsTitle"],
            Content = @Localizer["NormalTipsContent"]
        };
        await Toast.Show(option);
    }
});</Pre>
<div>@((MarkupString)Localizer["NormalTips5"].Value)</div>

<p>@((MarkupString)Localizer["PublishTip"].Value)</p>
<Pre class="mb-3">await DispatchService.DispatchAsync(new DispatchEntry&lt;MessageItem&gt;
{
    Name = nameof(MessageItem),
    Entry = new MessageItem { Message = "Hello BootstrapBlazor" }
});</Pre>

<DemoBlock Title="@Localizer["DispatchTitle"]" Introduction="@Localizer["DispatchIntro"]" Name="Dispatch">
    <section ignore>
        <p>@((MarkupString)Localizer["DispatchTip"].Value)</p>
        <Pre class="mb-3">public class MessageItem
{
    public string? Message { get; set; }
}</Pre>
    </section>
    <Button IsAsync="true" Icon="fa-regular fa-paper-plane" Text="@Localizer["DispatchNoticeButtonText"]" OnClickWithoutRender="OnDispatch"></Button>
</DemoBlock>
