@page "/file-viewer"

<h3>@Localizer["Title"]</h3>

<PackageTips Name="BootstrapBlazor.FileViewer" />

<Tips class="mt-3">
    <p>@((MarkupString)Localizer["Tips"].Value)</p>
</Tips>

<DemoBlock Title="@Localizer["BaseUsageText"]" Introduction="@Localizer["BaseUsageIntro"]" Name="Normal">
    <p>Word</p>
    <iframe title="Word" sandbox="allow-scripts" allow="fullscreen" srcdoc="@WordHtml" style="@PreviewStyle"></iframe>
    <p>Excel</p>
    <iframe title="Excel" sandbox="allow-scripts" allow="fullscreen" srcdoc="@ExcelHtml" style="@PreviewStyle"></iframe>
</DemoBlock>

<DemoBlock Title="@Localizer["BaseUsageText2"]" Introduction="@Localizer["BaseUsageIntro2"]" Name="Reload">
    <div class="row g-3">
        <div class="col-6 col-sm-4 col-md-3 col-xl-2">
            <Dropdown TValue="string" Items="Items" OnSelectedItemChanged="@ChangeURL" IsDisabled="_isLoading" />
        </div>
        <div class="col-6 col-sm-4 col-md-3 col-xl-5">
            <BootstrapInput @bind-Value="@Url" IsDisabled="_isLoading" />
        </div>
        <div class="col-6 col-sm-4 col-md-3 col-xl-auto">
            <Button Color="Color.Primary" OnClick="Apply" IsAsync="true" IsDisabled="_isLoading">@Localizer["Load"]</Button>
        </div>
    </div>

    <iframe title="@Localizer["BaseUsageText2"]" sandbox="allow-scripts" allow="fullscreen" srcdoc="@ReloadHtml" style="@PreviewStyle"></iframe>
</DemoBlock>

<AttributeTable Title="FileViewer" Items="_attributes" />
