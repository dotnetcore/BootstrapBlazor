@page "/connection-service"
@layout MainLayout
@inject IStringLocalizer<ConnectionServices> Localizer

<h3>@Localizer["Title"] <code>IConnectionService</code></h3>
<h4>@Localizer["SubTitle"]</h4>


<p class="code-label">@((MarkupString)Localizer["MiddlewareDescription"].Value)</p>

<Pre>public void Configure(IApplicationBuilder app)
{
    // @Localizer["AddMiddlewareComment"]
    app.UseBootstrapBlazor();
}</Pre>

<p class="code-label">@Localizer["InjectServiceTitle"]</p>

<Pre>[Inject]
[NotNull]
private IConnectionService? ConnectionService { get; set; }</Pre>

<p class="code-label">@Localizer["ConfigurationTitle"]</p>

<Pre>{
  "BootstrapBlazorOptions": {
    "ConnectionHubOptions": {
      "Enable": true,
      "EnableIpLocator": true,
      "ExpirationScanFrequency": "00:05:00",
      "TimeoutInterval": "00:03:00",
      "BeatInterval": "00:00:30"
    }
  }
}</Pre>

<ul class="ul-demo">
    <li>@((MarkupString)Localizer["EnableDescription"].Value)</li>
    <li>@((MarkupString)Localizer["EnableIpLocatorDescription"].Value)</li>
    <li>@((MarkupString)Localizer["ExpirationScanFrequencyDescription"].Value)</li>
    <li>@((MarkupString)Localizer["TimeoutIntervalDescription"].Value)</li>
    <li>@((MarkupString)Localizer["BeatIntervalDescription"].Value)</li>
</ul>

<p>@((MarkupString)Localizer["HeartbeatDescription"].Value)</p>

<Pre>&lt;ConnectionHub /&gt;</Pre>

<p class="code-label">@Localizer["UsageTitle"]</p>
<p>@((MarkupString)Localizer["UsageDescription"].Value)</p>

<Pre>var count = ConnectionService.Count;
var connections = ConnectionService.Connections;

if (ConnectionService.TryGetValue(connectionId, out var connection))
{
    var clientInfo = connection.ClientInfo;
}</Pre>

<p class="code-label">@Localizer["AsyncUpdateTitle"]</p>

<p>@((MarkupString)Localizer["AsyncUpdateDescription"].Value)</p>

<Pre>await ConnectionService.AddOrUpdateAsync(client, cancellationToken);</Pre>

