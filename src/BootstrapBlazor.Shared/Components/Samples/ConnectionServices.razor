<p class="code-label">@Localizer["EntityTitle", "ConnectionItem"]</p>

<Pre>public class ConnectionItem
{
    /// &lt;summary&gt;
    /// @Localizer["ConnectionIdComment"]
    /// &lt;/summary&gt;
    [NotNull]
    public string? Id { get; internal set; }

    /// &lt;summary&gt;
    /// @Localizer["ClientInfoComment"]
    /// &lt;/summary&gt;
    public ClientInfo? ClientInfo { get; set; }

    /// &lt;summary&gt;
    /// @Localizer["ConnectionTimeComment"]
    /// &lt;/summary&gt;
    public DateTimeOffset ConnectionTime { get; internal set; }

    /// &lt;summary&gt;
    /// @Localizer["LastBeatTimeComment"]
    /// &lt;/summary&gt;
    public DateTimeOffset LastBeatTime { get; internal set; }
}
</Pre>

<p class="code-label">@Localizer["EntityTitle", "ClientInfo"]</p>

<Pre>/// &lt;summary&gt;
/// @Localizer["ClientInfoSummary"]
/// &lt;/summary&gt;
public class ClientInfo
{
    /// &lt;summary&gt;
    /// @Localizer["ClientIdComment"]
    /// &lt;/summary&gt;
    public string? Id { get; set; }

    /// &lt;summary&gt;
    /// @Localizer["ClientIpComment"]
    /// &lt;/summary&gt;
    public string? Ip { get; set; }

    /// &lt;summary&gt;
    /// @Localizer["ClientCityComment"]
    /// &lt;/summary&gt;
    public string? City { get; set; }

    /// &lt;summary&gt;
    /// @Localizer["ClientBrowserComment"]
    /// &lt;/summary&gt;
    public string? Browser { get; set; }

    /// &lt;summary&gt;
    /// @Localizer["ClientOSComment"]
    /// &lt;/summary&gt;
    public string? OS { get; set; }

    /// &lt;summary&gt;
    /// @Localizer["ClientDeviceComment"]
    /// &lt;/summary&gt;
    [JsonConverter(typeof(JsonStringEnumConverter))]
    public WebClientDeviceType Device { get; set; }

    /// &lt;summary&gt;
    /// @Localizer["ClientLanguageComment"]
    /// &lt;/summary&gt;
    public string? Language { get; set; }

    /// &lt;summary&gt;
    /// @Localizer["ClientRequestUrlComment"]
    /// &lt;/summary&gt;
    public string? RequestUrl { get; set; }

    /// &lt;summary&gt;
    /// @Localizer["ClientUserAgentComment"]
    /// &lt;/summary&gt;
    public string? UserAgent { get; set; }

    /// &lt;summary&gt;
    /// @Localizer["ClientEngineComment"]
    /// &lt;/summary&gt;
    public string? Engine { get; set; }
}</Pre>

