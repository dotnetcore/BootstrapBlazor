@namespace BootstrapBlazor.Components
@inherits BootstrapModuleComponentBase
@attribute [BootstrapModuleAutoLoader("Toast/ToastContainer.razor.js")]

<div @attributes="@AdditionalAttributes" id="@Id" class="@ClassString" popover="manual">
    <CascadingValue Value="this" IsFixed="true">
        @foreach (var option in Toasts)
        {
            <Toast @key="@option" Options="@option" />
        }
    </CascadingValue>
</div>
